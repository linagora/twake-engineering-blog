---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { SITE } from '../site.config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import LinagoraLogo from './LinagoraLogo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: localizedPath(lang, 'tags'), label: t('nav.tags') },
  { href: localizedPath(lang, 'about'), label: t('nav.about') },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  class="sticky top-0 z-40 backdrop-blur supports-[backdrop-filter]:bg-[color-mix(in_oklab,var(--color-bg)_85%,transparent)] border-b border-border bg-bg"
>
  <div class="container-page flex items-center justify-between gap-4 h-16">
    <a
      href={localizedPath(lang)}
      class="flex items-center gap-3 group text-fg"
      aria-label={SITE.name}
    >
      <LinagoraLogo height={20} />
      <span aria-hidden="true" class="hidden sm:block w-px h-5 bg-border"></span>
      <span class="hidden sm:block text-sm text-muted tracking-wide">
        Engineering
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {
        navItems.map((item) => {
          const active = currentPath === item.href || currentPath.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-1.5 rounded-md text-sm transition-colors',
                active
                  ? 'text-fg font-medium'
                  : 'text-muted hover:text-fg hover:bg-surface-hover',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-search-open
        class="btn-ghost text-sm"
        aria-label={t('nav.search')}
        title={`${t('nav.search')}  ⌘K`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="hidden lg:inline text-muted">⌘K</span>
      </button>

      <LanguageSwitcher />
      <ThemeToggle />

      <a
        href={`/rss-${lang}.xml`}
        class="btn-ghost"
        aria-label={t('rss.subscribe')}
        title={t('rss.subscribe')}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </div>
</header>
