---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { SITE, githubRepoUrl } from '../site.config';
import LinagoraLogo from './LinagoraLogo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="container-page py-16 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5 flex flex-col gap-4">
      <div class="flex items-center gap-3 text-fg">
        <LinagoraLogo height={24} />
        <span aria-hidden="true" class="w-px h-6 bg-border"></span>
        <span class="text-sm text-muted-strong tracking-wide">Engineering</span>
      </div>
      <p class="text-sm text-muted leading-relaxed max-w-md">
        {SITE.description[lang]}
      </p>
      <div class="flex items-center gap-2 mt-2">
        <a
          href={githubRepoUrl()}
          class="btn-ghost text-sm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.83-.26.83-.58 0-.29-.01-1.04-.02-2.05-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.61-.01 2.91-.01 3.3 0 .32.22.7.83.58A12 12 0 0 0 12 .3z"/>
          </svg>
          GitHub
        </a>
        <a
          href={`/rss-${lang}.xml`}
          class="btn-ghost text-sm"
          aria-label={t('rss.subscribe')}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          RSS
        </a>
      </div>
    </div>

    <div class="md:col-span-3 flex flex-col gap-2.5 text-sm">
      <span class="text-xs uppercase tracking-[0.18em] text-muted font-semibold mb-1">
        {t('footer.navigation')}
      </span>
      <a class="hover:text-accent w-fit transition-colors" href={localizedPath(lang)}>{t('nav.home')}</a>
      <a class="hover:text-accent w-fit transition-colors" href={localizedPath(lang, 'tags')}>{t('nav.tags')}</a>
      <a class="hover:text-accent w-fit transition-colors" href={localizedPath(lang, 'about')}>{t('nav.about')}</a>
    </div>

    <div class="md:col-span-4 flex flex-col gap-2.5 text-sm">
      <span class="text-xs uppercase tracking-[0.18em] text-muted font-semibold mb-1">
        {t('footer.links')}
      </span>
      <a class="hover:text-accent w-fit transition-colors" href="https://linagora.com" target="_blank" rel="noopener noreferrer">linagora.com →</a>
      <a class="hover:text-accent w-fit transition-colors" href="https://twake.app" target="_blank" rel="noopener noreferrer">twake.app →</a>
      {SITE.social.mastodon && (
        <a class="hover:text-accent w-fit transition-colors" href={SITE.social.mastodon} target="_blank" rel="noopener noreferrer me">Mastodon</a>
      )}
      {SITE.social.linkedin && (
        <a class="hover:text-accent w-fit transition-colors" href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-page py-5 flex flex-col md:flex-row gap-2 items-center justify-between text-xs text-muted">
      <span>© {year} Linagora. {t('footer.allRights')}</span>
      <span>
        {t('footer.builtWith')}
        <a href="https://astro.build" class="hover:text-accent" target="_blank" rel="noopener noreferrer">Astro</a>
      </span>
    </div>
  </div>
</footer>
