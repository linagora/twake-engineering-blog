---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import AuthorAvatar from '../../../components/AuthorAvatar.astro';
import { getAllAuthorsWithPosts, getPostsByAuthor, getAuthor } from '../../../lib/posts';
import { useTranslations } from '../../../i18n/utils';
import { langs, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    const authors = await getAllAuthorsWithPosts(lang);
    for (const author of authors) {
      paths.push({
        params: { lang, author: author.id },
        props: { authorId: author.id },
      });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { authorId } = Astro.props;
const t = useTranslations(lang);
const author = await getAuthor(authorId);
const posts = author ? await getPostsByAuthor(lang, authorId) : [];

if (!author) {
  return Astro.redirect(`/${lang}`);
}
---

<BaseLayout title={author.data.name} description={author.data.bio}>
  <section class="container-page py-14 md:py-20 border-b border-border">
    <div class="flex flex-col md:flex-row gap-6 md:items-center">
      <AuthorAvatar author={author} size="lg" />
      <div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{author.data.name}</h1>
        {author.data.title && <p class="mt-1 text-muted-strong">{author.data.title}</p>}
        {author.data.bio && <p class="mt-3 text-muted-strong max-w-2xl leading-relaxed">{author.data.bio}</p>}
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          {author.data.github && (
            <a class="hover:text-accent text-muted" href={`https://github.com/${author.data.github}`} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          )}
          {author.data.linkedin && (
            <a class="hover:text-accent text-muted" href={`https://www.linkedin.com/in/${author.data.linkedin}`} target="_blank" rel="noopener noreferrer">
              LinkedIn
            </a>
          )}
          {author.data.mastodon && (
            <a class="hover:text-accent text-muted" href={author.data.mastodon} target="_blank" rel="noopener noreferrer me">
              Mastodon
            </a>
          )}
          {author.data.website && (
            <a class="hover:text-accent text-muted" href={author.data.website} target="_blank" rel="noopener noreferrer">
              Website
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-12 md:py-16">
    <h2 class="text-sm uppercase tracking-wider text-muted font-medium mb-6">
      {t('authors.articlesBy')} {author.data.name}
    </h2>

    {
      posts.length === 0 ? (
        <p class="text-muted">{t('authors.noArticles')}</p>
      ) : (
        <div class="grid md:grid-cols-2 gap-6">
          {posts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
