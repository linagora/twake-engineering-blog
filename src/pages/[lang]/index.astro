---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPostsByLang, getAllTags } from '../../lib/posts';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { langs, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPostsByLang(lang);
const tagCounts = await getAllTags(lang);
const topTags = [...tagCounts.entries()].slice(0, 6);
const [featured, ...rest] = posts;
---

<BaseLayout>
  {/* HERO — centered, soft radial gradient backdrop, decorative grid */}
  <section class="relative overflow-hidden border-b border-border">
    <div
      class="absolute inset-0 -z-10"
      aria-hidden="true"
      style="background:
        radial-gradient(ellipse 60% 80% at 50% 0%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 70%),
        radial-gradient(ellipse 40% 60% at 80% 100%, color-mix(in oklab, var(--accent) 10%, transparent), transparent 70%);"
    >
    </div>
    <div class="absolute inset-0 -z-10 opacity-[0.35] dark:opacity-[0.15]" aria-hidden="true">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <pattern id="dots" width="32" height="32" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="currentColor" class="text-muted" />
          </pattern>
          <radialGradient id="fade" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="black" stop-opacity="1" />
            <stop offset="100%" stop-color="black" stop-opacity="0" />
          </radialGradient>
          <mask id="dot-mask">
            <rect width="100%" height="100%" fill="url(#fade)" />
          </mask>
        </defs>
        <rect width="100%" height="100%" fill="url(#dots)" mask="url(#dot-mask)" />
      </svg>
    </div>

    <div class="container-page py-20 md:py-28 lg:py-32 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-bg/60 backdrop-blur text-xs font-medium uppercase tracking-[0.18em] text-muted-strong">
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        {lang === 'fr' ? 'Open source · Ingénierie' : 'Open source · Engineering'}
      </span>

      <h1 class="mt-6 text-4xl md:text-6xl lg:text-7xl font-bold tracking-[-0.025em] leading-[1.02] max-w-4xl mx-auto">
        {t('home.hero.title')}
      </h1>

      <p class="mt-6 text-lg md:text-xl text-muted-strong leading-relaxed max-w-2xl mx-auto">
        {t('home.hero.subtitle')}
      </p>

      {
        topTags.length > 0 && (
          <div class="mt-9 flex flex-wrap justify-center gap-2">
            {topTags.map(([tag, count]) => (
              <a href={localizedPath(lang, `tags/${tag}`)} class="pill">
                #{tag}
                <span class="ml-1.5 text-muted">({count})</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* ARTICLES */}
  <section class="container-page py-16 md:py-20">
    {
      posts.length === 0 ? (
        <p class="text-muted text-center py-12">{t('home.empty')}</p>
      ) : (
        <>
          <div class="flex items-end justify-between mb-8">
            <div>
              <p class="text-xs uppercase tracking-[0.18em] text-accent font-semibold mb-2">
                {t('home.latest')}
              </p>
              <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
                {lang === 'fr' ? 'Tous les articles' : 'All articles'}
              </h2>
            </div>
            <a
              href={`/rss-${lang}.xml`}
              class="hidden md:inline-flex btn-ghost text-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
              RSS
            </a>
          </div>

          <div class="flex flex-col gap-8">
            {featured && <ArticleCard post={featured} featured />}

            {rest.length > 0 && (
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {rest.map((post) => (
                  <ArticleCard post={post} />
                ))}
              </div>
            )}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
