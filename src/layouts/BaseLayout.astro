---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { SITE } from '../site.config';
import { langs as allLangs, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  authors?: string[];
  canonical?: string;
  /** Languages in which this page actually exists. Defaults to all locales. */
  translations?: Lang[];
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  authors,
  canonical,
  translations = allLangs,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const desc = description ?? SITE.description[lang];
const ogImage = image ?? '/og-default.png';
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${t('site.tagline')}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(fr|en)/, '') || '/';
const baseUrl = Astro.site ?? SITE.url;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (FR)`} href="/rss-fr.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (EN)`} href="/rss-en.xml" />
    {
      translations.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(`/${l}${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`, baseUrl).toString()}
        />
      ))
    }

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? SITE.url).toString()} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:site_name" content={SITE.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {authors && authors.map((a) => <meta property="article:author" content={a} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored ?? (prefers ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (_e) {
          /* localStorage may be unavailable */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:btn-primary">
      {t('a11y.skipToContent')}
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
